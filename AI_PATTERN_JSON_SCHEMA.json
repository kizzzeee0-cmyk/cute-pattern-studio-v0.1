{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cute-pattern-studio.local/schema/ai-pattern-response.schema.json",
  "title": "Cute Pattern Studio AI Pattern Response",
  "type": "object",
  "required": ["schema_version", "source", "suggestions"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1"
    },
    "source": {
      "type": "string",
      "enum": ["ai", "fallback"]
    },
    "ok": {
      "type": "boolean"
    },
    "note": {
      "type": "string"
    },
    "suggestions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/suggestion"
      }
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "bg": {
      "type": "object",
      "required": ["transparent", "mode", "colors", "gradientAngle"],
      "properties": {
        "transparent": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["solid", "linear"] },
        "colors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/hex" }
        },
        "gradientAngle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 360
        }
      },
      "additionalProperties": false
    },
    "layer": {
      "type": "object",
      "required": [
        "enabled", "sourceType", "presetId", "colors", "size", "gap", "jitter",
        "rotation", "stroke", "opacity", "detail", "randomSize", "randomAngle",
        "randomPosition", "offsetX", "offsetY"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "sourceType": { "type": "string", "const": "builtin" },
        "presetId": { "type": "string" },
        "colors": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/hex" }
        },
        "size": { "type": "integer", "minimum": 12, "maximum": 220 },
        "gap": { "type": "integer", "minimum": 0, "maximum": 140 },
        "jitter": { "type": "integer", "minimum": 0, "maximum": 100 },
        "rotation": { "type": "integer", "minimum": -180, "maximum": 180 },
        "stroke": { "type": "integer", "minimum": 0, "maximum": 18 },
        "opacity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "detail": { "type": "integer", "minimum": 0, "maximum": 100 },
        "randomSize": { "type": "boolean" },
        "randomAngle": { "type": "boolean" },
        "randomPosition": { "type": "boolean" },
        "offsetX": { "type": "integer", "minimum": -200, "maximum": 200 },
        "offsetY": { "type": "integer", "minimum": -200, "maximum": 200 }
      },
      "additionalProperties": false
    },
    "suggestion": {
      "type": "object",
      "required": ["id", "title", "summary", "tags", "bg", "layers"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 12
        },
        "bg": { "$ref": "#/$defs/bg" },
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/layer" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
